<%- include ('../partials/head') %>
  </head>
  <body class="bg-gray-50 min-h-screen">

    <!-- Header -->
   <%- include('../partials/nav') %>

    <!-- Main Content -->
    <main class="max-w-4xl mx-auto mt-10 p-6 bg-white rounded-2xl shadow-lg">
      <h2 class="text-2xl font-semibold text-red-600 mb-4">Here are your registered homes:</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <% if (registeredHomes.length > 0) { %>
          <% registeredHomes.forEach(home => { %>
            <div class="bg-white rounded-xl shadow group hover:shadow-lg border border-red-100 overflow-hidden flex flex-row items-center p-8">
              <% if (home.Photo) { %>
                <img 
                  src="<%= home.Photo %>" 
                  alt="<%= home.houseName %> photo" 
                  class="w-20 h-20 md:w-24 md:h-24 object-cover object-center rounded-lg shadow-sm border mr-4 flex-shrink-0"
                >
              <% } else { %>
                <div class="w-20 h-20 md:w-24 md:h-24 bg-gray-200 flex items-center justify-center text-gray-500 rounded-lg shadow-sm border mr-4 flex-shrink-0">
                  No image
                </div>
              <% } %>
              <div class="flex-1">
                <h3 class="text-lg md:text-xl font-bold text-red-700 mb-1"><%= home.houseName %></h3>
                <div class="space-y-0.5">
                  <p class="text-gray-700 text-sm md:text-base">
                    <span class="font-semibold text-gray-800">Price per Night:</span>
                    <span class="text-green-600"><%= home.Pricepernight || '-' %></span>
                  </p>
                  <p class="text-gray-700 text-sm md:text-base">
                    <span class="font-semibold text-gray-800">Location:</span>
                    <%= home.Locations || '-' %>
                  </p>
                  <p class="text-gray-700 text-sm md:text-base">
                    <span class="font-semibold text-gray-800">Rating:</span>
                    <% if (home.Ratings) { %>
                      <span class="inline-flex items-center">
                        <%= home.Ratings %>
                        <svg class="w-4 h-4 text-yellow-400 ml-1" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.943a1 1 0 00.95.69h4.15c.969 0 1.371 1.24.588 1.81l-3.36 2.44a1 1 0 00-.364 1.118l1.287 3.943c.3.921-.755 1.688-1.539 1.118l-3.36-2.44a1 1 0 00-1.175 0l-3.36 2.44c-.783.57-1.838-.197-1.539-1.118l1.287-3.943a1 1 0 00-.364-1.118l-3.36-2.44c-.783-.57-.38-1.81.588-1.81h4.15a1 1 0 00.95-.69l1.286-3.943z"/></svg>
                      </span>
                    <% } else { %>
                      <span>-</span>
                    <% } %>
                  </p>
                </div>
                <a href = "/host/edit-home/<%=home._id%>?editing=true" class="BG bg-green-400 p-3">Edit</a>
                <form action = "/host/delete-home/<%= home._id%>" method="POST">
                <button class = "BG bg-red-400 p-2">Delete</button>
                </form>
              </div>
           </div>
          <% }) %>
        <% } else { %>
          <p class="text-gray-500 italic">No homes registered yet.</p>

        <% } %>
        </div>
    </main>

  </body>
</html>
