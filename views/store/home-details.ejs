<%- include ('../partials/head') %>
</head>
<body class="bg-gray-100 min-h-screen">

  <%- include('../partials/nav') %>

  <main class="max-w-5xl mx-auto mt-10 p-6 bg-white rounded-2xl shadow-lg">
    
    <!-- Home Title -->
    <h1 class="text-3xl font-bold text-gray-800 mb-6 border-b pb-3">
      <%= home.houseName %> 🏠
    </h1>

    <!-- Home Content Layout -->
    <div class="flex flex-col md:flex-row gap-8">
      
      <!-- Home Image -->
      

      <div class="flex-shrink-0">
        <% if (home.Photo) { %>
          <img src="<%= home.Photo %>"
            alt="<%= home.houseName %> photo" 
            class="w-72 h-72 rounded-xl shadow-md object-cover border"
          >
        <% } else { %>
          <div class="w-72 h-72 bg-gray-200 flex items-center justify-center text-gray-500 rounded-xl shadow-md border">
            No Image Available
          </div>
        <% } %>
      </div>

      <!-- Text Info -->
      <div class="flex-1 space-y-5">
        <p class="text-xl text-gray-700">
          <span class="font-semibold">Price Per Night:</span> 
          <span class="text-green-600 font-bold">₹ <%= home.Pricepernight %></span>
        </p>

        <p class="text-xl text-gray-700">
          <span class="font-semibold">Location:</span>
          <%= home.Locations %>
        </p>

        <p class="text-xl text-gray-700">
          <span class="font-semibold">Rating:</span>
          <% if (home.Ratings) { %>
            ⭐ <%= home.Ratings %> / 5
          <% } else { %>
            -
          <% } %>
        </p>
        
        
         <div class="flex gap-4 mt-8">
          <a href="/rules/<%= home._id %> " class=" text-blue-700 font-medium transition' :' hover:text-blue-900 font-medium transition'">
          Rules for this home
          </a>



        <!-- Buttons -->
        <div class="flex gap-4 mt-8">
          <a href="/homes" class="px-4 py-2 bg-gray-300 hover:bg-gray-400 rounded-lg shadow">
            ← Back to Homes
          </a>
          
         <%- include('../partials/favourites') %>
        </div>
      </div>
    </div>
  </main>

</body>
</html>
