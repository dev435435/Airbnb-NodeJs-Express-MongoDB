<%- include ('../partials/head') %>
  </head>
  <body class="bg-gray-50 min-h-screen">

    <!-- Header -->
   <%- include('../partials/nav') %>

    <!-- Main Section --> 
    <main class="flex justify-center items-center mt-16">
      <form action="/login" method="POST" 
        class="bg-white p-8 rounded-2x1 shadow-lg w-full max-w-md border border-red-100">
        
        <h2 class="text-2xl font-semibold text-red-600 mb-6 text-center">Login</h2>
        
        <%- include('../partials/error', { errors: errors }) %>
        
        <div class="mb-4">
          
          <input 
            type="email" 
            name="email" 
            placeholder="Enter your email"
            value = "<%= oldInput.email ? oldInput.email : ''%>"
            class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-red-400"
            required
          >
        </div>

        <div class="mb-4">
          
          <input 
            type="password" 
            name="password" 
            placeholder="Enter your password"
            class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-red-400"
            required
          >
        </div>
        
        
       
        <button 
          type="submit" 
          class="w-full bg-red-600 text-white font-medium py-2 rounded-lg hover:bg-red-700 transition">
          Sign in
        </button>
      </form>
    </main>

  </body>
</html>
